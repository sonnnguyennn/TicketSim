{
  "name": "vps-support-ticket-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs && node scripts/prepare-guided.mjs",
    "predev": "npm run prepare-data",
    "prebuild": "npm run prepare-data",
    "pretest": "npm run prepare-data && npm run audit:content",
    "audit:content": "node scripts/audit-content.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "real-lab:agent": "node agent/server.mjs",
    "real-lab:operator": "node operator/server.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "^8.20.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "1.17.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
