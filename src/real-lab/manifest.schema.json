{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ticketsim.local/schemas/real-lab-scenario-v1.json",
  "title": "TicketSim Real Lab scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "title", "relatedTicketIds", "guestOS", "vmProfileId", "controller", "setupActionId", "faultCheckIds", "gradeCheckIds", "rollbackActionId", "safety"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^LAB-[A-Z0-9-]+$" },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "relatedTicketIds": { "$ref": "#/definitions/ids" },
    "guestOS": { "const": "ubuntu-22.04" },
    "vmProfileId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "controller": { "enum": ["hyperv", "multipass"] },
    "setupActionId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "faultCheckIds": { "$ref": "#/definitions/ids" },
    "gradeCheckIds": { "$ref": "#/definitions/ids" },
    "rollbackActionId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposableOnly", "hostRecoveryRequired", "maxMinutes"],
      "properties": {
        "disposableOnly": { "const": true },
        "hostRecoveryRequired": { "const": true },
        "maxMinutes": { "type": "integer", "minimum": 1, "maximum": 240 }
      }
    }
  },
  "definitions": {
    "ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
  }
}
